{
  "name": "realestate-platform-backend",
  "version": "1.0.0",
  "description": "Backend API for Real Estate Platform",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node scripts/setup-db.js && node dist/index.js",
    "start:with-db": "node scripts/setup-db.js && node dist/index.js",
    "start:render": "npx prisma db push --skip-generate; node dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:setup": "node scripts/setup-db.js",
    "validate-env": "node scripts/validate-env.js",
    "validate-csp": "node scripts/validate-csp.js",
    "security-check": "node scripts/security-check.js",
    "audit": "npm audit --audit-level=moderate",
    "audit:fix": "npm audit fix",
    "type-check": "tsc --noEmit",
    "lint": "echo 'No linter configured. Consider adding ESLint.'",
    "verify-hsts": "npm run build && node scripts/verify-hsts-detection.js",
    "s3-deletion-worker": "tsx scripts/run-s3-deletion-worker.ts",
    "s3-deletion-worker:dry-run": "DRY_RUN=true tsx scripts/run-s3-deletion-worker.ts",
    "test:s3-deletion": "node scripts/test-s3-deletion-flow.js",
    "test:s3-deletion:live": "DRY_RUN=false node scripts/test-s3-deletion-flow.js",
    "test:s3-deletion:cleanup": "CLEANUP=true node scripts/test-s3-deletion-flow.js",
    "test:export-pagination": "node scripts/test-export-pagination.js",
    "test:export-size-limits": "node scripts/test-export-size-limits.js",
    "verify:production-bypass": "node scripts/verify-production-bypass-disabled.js",
    "test:bypass-production": "powershell -ExecutionPolicy Bypass -File scripts/create-test-user-and-test-bypass.ps1",
    "clear:export-rate-limit": "node scripts/clear-export-rate-limit.js",
    "clear:export-rate-limit:user": "node scripts/clear-export-rate-limit.js",
    "job:cleanup": "tsx src/jobs/cleanupJob.ts",
    "job:queue-monitor": "tsx src/jobs/queueMonitorJob.ts",
    "job:db-monitor": "tsx src/jobs/dbMonitorJob.ts",
    "ping:health": "node scripts/ping-health.js",
    "test:cleanup": "node scripts/test-cleanup-job.js",
    "security:smoke": "node scripts/security-validation/run-all-tests.js",
    "test:dealroom-core": "node scripts/test-dealroom-core.js",
    "preflight": "node scripts/preflight-production-check.js",
    "preflight:production": "NODE_ENV=production node scripts/preflight-production-check.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.821.0",
    "@aws-sdk/s3-request-presigner": "^3.821.0",
    "@paralleldrive/cuid2": "^2.2.2",
    "@prisma/client": "^6.7.0",
    "@sentry/node": "^10.32.1",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "@google/generative-ai": "^0.24.1",
    "redis": "^5.10.0",
    "stripe": "^17.3.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.11.0",
    "prisma": "^6.7.0",
    "tsx": "^4.7.1",
    "typescript": "^5.3.3"
  }
}
