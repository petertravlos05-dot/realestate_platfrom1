# Add directories or file patterns to ignore during indexing (e.g. foo/ or *.csv)
# .cursorignore - Heavy, generated, or unnecessary paths to prevent OOM during indexing
# Auto-generated based on: Node.js, Next.js, Python/Django, Expo, Prisma

# Node.js / npm
node_modules/

# Build outputs
dist/
build/
.next/
out/

