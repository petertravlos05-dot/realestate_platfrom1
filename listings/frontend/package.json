{
  "name": "realestate-platform-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--max-old-space-size=8192 next dev",
    "dev:fast": "cross-env NODE_OPTIONS=--max-old-space-size=8192 NEXT_PUBLIC_SENTRY_ENABLE=false next dev --turbo",
    "build": "cross-env NODE_OPTIONS=--max-old-space-size=12288 prisma generate && cross-env NODE_OPTIONS=--max-old-space-size=12288 next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "audit": "npm audit --audit-level=moderate",
    "audit:fix": "npm audit fix",
    "postinstall": "prisma generate && node install-tailwind.js",
    "fix-deps": "npm install require-in-the-middle --save",
    "prisma:generate": "prisma generate",
    "preflight": "node scripts/preflight-production-check.js",
    "preflight:production": "NODE_ENV=production node scripts/preflight-production-check.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.821.0",
    "@headlessui/react": "^2.2.0",
    "@heroicons/react": "^2.2.0",
    "@hookform/resolvers": "^5.0.1",
    "@next-auth/prisma-adapter": "^1.0.7",
    "@paralleldrive/cuid2": "^2.2.2",
    "@prisma/client": "^6.7.0",
    "@radix-ui/react-dialog": "^1.1.6",
    "@react-google-maps/api": "^2.20.6",
    "@sentry/nextjs": "^10.32.1",
    "@tailwindcss/line-clamp": "^0.4.4",
    "@tanstack/react-query": "^5.75.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/canvas-confetti": "^1.9.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/react-datepicker": "^6.2.0",
    "axios": "^1.8.4",
    "bcryptjs": "^3.0.2",
    "canvas-confetti": "^1.9.4",
    "date-fns": "^4.1.0",
    "debug": "^4.4.0",
    "framer-motion": "^12.9.4",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.577.0",
    "next": "^14.1.0",
    "next-auth": "^4.24.11",
    "node-fetch": "^3.3.2",
    "openai": "^6.27.0",
    "react": "^18.2.0",
    "react-datepicker": "^8.2.1",
    "react-day-picker": "^9.6.3",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.56.1",
    "react-hot-toast": "^2.5.2",
    "react-tooltip": "^5.28.1",
    "require-in-the-middle": "^8.0.1",
    "stripe": "^18.5.0",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@alloc/quick-lru": "^5.2.0",
    "@sentry/types": "^10.32.1",
    "@types/debug": "^4.1.12",
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "arg": "^5.0.2",
    "autoprefixer": "^10.4.23",
    "chokidar": "^5.0.0",
    "cross-env": "^10.1.0",
    "didyoumean": "^1.2.2",
    "dlv": "^1.1.3",
    "esbuild": "^0.25.3",
    "eslint": "9.34.0",
    "eslint-config-next": "15.5.2",
    "fast-glob": "^3.3.3",
    "glob-parent": "^6.0.2",
    "is-glob": "^4.0.3",
