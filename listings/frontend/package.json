    "postcss": "^8.5.6",
    "postcss-import": "^16.1.1",
    "postcss-js": "^5.0.3",
    "postcss-load-config": "^6.0.1",
    "postcss-nested": "^7.0.2",
    "postcss-selector-parser": "^7.1.1",
    "prisma": "^6.7.0",
    "react-icons": "^5.5.0",
    "resolve": "^1.22.11",
    "sucrase": "^3.35.1",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.3.3"
  }
